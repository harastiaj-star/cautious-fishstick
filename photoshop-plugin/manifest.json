{
  "manifestVersion": 5,
  "id": "com.trailhead.photoshop",
  "name": "Trailhead",
  "version": "1.4.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "trailheadPanel",
      "label": {
        "default": "Trailhead"
      },
      "minimumSize": {
        "width": 240,
        "height": 320
      },
      "maximumSize": {
        "width": 2000,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 680
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "https://ntfy.sh"
      ]
    }
  }
}
